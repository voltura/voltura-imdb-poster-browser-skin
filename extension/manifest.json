{
  "manifest_version": 3,
  "name": "Voltura IMDb Poster Browser",
  "version": "1.5.0",
  "description": "Browse IMDb filmographies as posters. Search and sort acting, writing, producing and directing credits with IMDb and RT scores.",
  "homepage_url": "https://imdb.voltura.se/",
  "permissions": ["storage"],
  "host_permissions": ["https://www.rottentomatoes.com/*"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "content_scripts": [{
    "matches": ["https://www.imdb.com/name/nm*", "https://imdb.com/name/nm*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}
}
